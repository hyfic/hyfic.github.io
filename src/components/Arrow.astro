---
interface Props {
  diagonal?: boolean;
}
const { diagonal = false } = Astro.props;
---

<svg
  class="arrow"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  aria-hidden="true"
>
  {diagonal ? (
    <path d="M6 18 18 6M6 6h12v12" />
  ) : (
    <path d="M4 12h15m-6-6 6 6-6 6" />
  )}
</svg>
<style>
  .arrow {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
</style>
