---
import '../lib/pixel-fonts.css';
---

<a class="hyfic-wordmark" href="/" aria-label="Hyfic home">
  hyfic
</a>
<style>
  .hyfic-wordmark {
    display: inline-block;
    font-family: 'Pixeloid Sans', sans-serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    color: inherit;
    text-decoration: none;
    transition: opacity 180ms;
  }
  .hyfic-wordmark:hover {
    opacity: 0.8;
  }
  .hyfic-wordmark:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: reduce) {
    .hyfic-wordmark {
      transition: none;
    }
  }
</style>
