---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import AppFooter from '../../components/AppFooter.astro';
import '../../styles/log-horizon.css';
const faq = [
  [
    'What is Log Horizon?',
    'A local desktop diary with two ways to write. Freewrite gives you a continuous page, while Pile collects individual thoughts into a chronological stream. Titles are optional.',
  ],
  [
    'Does it need an account or internet?',
    'No. Your diary lives on your computer. There are no accounts, cloud sync, analytics, or AI services.',
  ],
  [
    'Can I keep an entry private?',
    'Yes. Selected entries and entire piles can be encrypted with one diary password. Ordinary entries are not encrypted. Dates and the existence of private entries remain visible. There is no password reset, so keep your password safe.',
  ],
  [
    'Can I take my writing with me?',
    'Export entries as Markdown, or save a full diary backup and restore it into an empty diary. Keep backups somewhere safe; there is no automatic cloud backup.',
  ],
  [
    'Where can I get it?',
    'A public release link will be added here when it is ready. In the meantime, you can email Fadhil about Log Horizon.',
  ],
];
---

<Base
  title="Log Horizon — A little room to think. | Hyfic"
  description="A quiet, local desktop diary. Write freely, collect passing thoughts, and keep selected entries private. No accounts. No cloud."
  themeColor="#eae8e0"
  canonical="https://hyfic.org/log-horizon/"
  ogTitle="Log Horizon — A little room to think."
  ogDescription="A quiet, local desktop diary. A Hyfic project by Fadhil Saheer."
  ogImage="https://hyfic.org/images/log-horizon-preview.jpg"
>
  <a class="skip" href="#main">
    Skip to content
  </a>
  <div class="app-page journal-page">
    <header class="journal-hero">
      <div class="app-nav">
        <a class="app-brand" href="/log-horizon/">
          <img src="/images/log-horizon.png" alt="" width="32" height="32" />
          Log Horizon
        </a>
        <nav aria-label="Log Horizon navigation">
          <a href="#features">Features</a>
          <a href="#faq">FAQ</a>
          <a class="nav-release" href="#release">
            Get the app
          </a>
        </nav>
      </div>
      <div class="app-intro">
        <h1>
          A little room
          <br />
          to think.
        </h1>
        <p>
          For the days that fill a page.
          <br />
          And the thoughts that only need a line.
        </p>
        <a class="button journal-button" href="#features">
          Find your writing space <Arrow />
        </a>
        <span class="release-note">
          A local desktop diary. Just you and your words.
        </span>
      </div>
      <figure class="journal-preview">
        <img
          src="/images/log-horizon-preview.jpg"
          alt="Log Horizon Freewrite with a sample diary entry titled A little room to think"
          width="1280"
          height="720"
          fetchpriority="high"
        />
      </figure>
      <p class="preview-caption">An actual app preview, with a sample diary.</p>
    </header>
    <main id="main">
      <section
        class="app-features"
        id="features"
        aria-labelledby="features-title"
      >
        <h2 id="features-title">However your thoughts arrive.</h2>
        <div class="writing-modes">
          <article>
            <div class="mode-art freewrite-art">
              <span>Freewrite</span>
              <p>
                Some days, the words
                <br />
                just need somewhere to go.
                <br />
                <br />
                Start anywhere.
              </p>
              <i aria-hidden="true"></i>
            </div>
            <h3>Let the page unfold.</h3>
            <p>
              Write without a format to fill. No required title, no
              distractions. Your words save as you go.
            </p>
          </article>
          <article>
            <div class="mode-art pile-art">
              <span>Pile</span>
              <p>The first cup of coffee, before the day gets loud.</p>
              <p>Maybe the small things are the big things.</p>
              <div>
                A thought for later…{' '}
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 16V4m-5 5 5-5 5 5" />
                </svg>
              </div>
            </div>
            <h3>Catch the passing thoughts.</h3>
            <p>
              A line now, another later. Collect little moments in a stream that
              can stretch across days.
            </p>
          </article>
        </div>
        <div class="journal-notes">
          <p>
            <strong>Your computer. Your diary.</strong>
            <br />
            No account or internet needed.
          </p>
          <p>
            <strong>A little more privacy.</strong>
            <br />
            Password-protect selected entries.
          </p>
          <p>
            <strong>Your words can come with you.</strong>
            <br />
            Markdown exports and local backups.
          </p>
        </div>
      </section>
      <section class="app-faq" id="faq">
        <h2>
          A few things
          <br />
          to know.
        </h2>
        <div class="faq-list">
          {faq.map(([question, answer]) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>
      <section class="app-closing" id="release">
        <img src="/images/log-horizon.png" alt="" width="54" height="54" />
        <h2>Make a little space for yourself.</h2>
        <p>No audience. No streak to keep. Just a place to write.</p>
        <a
          class="button journal-button"
          href="mailto:fadhil@hyfic.org?subject=Log%20Horizon%20release"
        >
          Ask about the release <Arrow diagonal />
        </a>
        <small>Desktop release link coming soon.</small>
      </section>
    </main>
    <AppFooter name="Log Horizon" />
  </div>
</Base>
